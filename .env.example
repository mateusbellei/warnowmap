# O feed GDELT é público e não requer chave. Nunca coloque segredos no app/.
NUXT_GDELT_ENABLED=true
# Desative o provedor para uma demonstração local explicitamente sinalizada.
# NUXT_GDELT_ENABLED=false

# PostgreSQL de produção (backend apenas). Migre antes de ativar a coleta.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Alternativa local persistente; nunca use SQLite em /tmp da Vercel.
# WARNOW_SQLITE_PATH=.data/monitor.sqlite
# Bearer de pelo menos 32 caracteres para POST /api/admin/ingest.
# WARNOW_INGEST_SECRET=
